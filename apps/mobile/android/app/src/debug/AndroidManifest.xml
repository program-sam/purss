<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (never in a release build): lets `adb shell am broadcast -a app.purss.DEBUG_PUSH
  -n app.purss/.DebugPushReceiver` run what a push from the relay runs, on an emulator without
  Firebase. Only callers holding DUMP (the adb shell) may send it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugPushReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.purss.DEBUG_PUSH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
