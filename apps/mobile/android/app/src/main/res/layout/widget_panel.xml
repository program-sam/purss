<?xml version="1.0" encoding="utf-8"?>
<!-- A home-screen panel (plan/38), in the app's look: a card header with the logo, heading and count; the episode
     (To listen only); and up to eight rows, each with its source's tile, as the app's lists. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:background="@drawable/widget_header_band"
        android:minHeight="24dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">
        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher_round" />
        <TextView
            android:id="@+id/widget_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_to_read"
            android:textColor="@color/widget_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:textColor="@color/widget_ink_2"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_header_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_band_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/widget_episode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/widget_episode_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_episode_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/widget_episode_status"
                    style="@style/WidgetRowMeta" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/widget_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:scaleType="center"
                android:src="@drawable/ic_widget_play"
                android:tint="@color/widget_accent" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="@color/widget_line"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/widget_not_connected"
            android:textColor="@color/widget_ink_2"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/widget_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="2dp">

        <LinearLayout
            android:id="@+id/widget_row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_avatar_0"
                style="@style/WidgetAvatar" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_title_0"
                    style="@style/WidgetRowTitle" />
                <TextView
                    android:id="@+id/widget_source_0"
                    style="@style/WidgetRowMeta" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_avatar_1"
                style="@style/WidgetAvatar" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_title_1"
                    style="@style/WidgetRowTitle" />
                <TextView
                    android:id="@+id/widget_source_1"
                    style="@style/WidgetRowMeta" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_avatar_2"
                style="@style/WidgetAvatar" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_title_2"
                    style="@style/WidgetRowTitle" />
                <TextView
                    android:id="@+id/widget_source_2"
                    style="@style/WidgetRowMeta" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_avatar_3"
                style="@style/WidgetAvatar" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_title_3"
                    style="@style/WidgetRowTitle" />
                <TextView
                    android:id="@+id/widget_source_3"
                    style="@style/WidgetRowMeta" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_avatar_4"
                style="@style/WidgetAvatar" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_title_4"
                    style="@style/WidgetRowTitle" />
                <TextView
                    android:id="@+id/widget_source_4"
                    style="@style/WidgetRowMeta" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_avatar_5"
                style="@style/WidgetAvatar" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_title_5"
                    style="@style/WidgetRowTitle" />
                <TextView
                    android:id="@+id/widget_source_5"
                    style="@style/WidgetRowMeta" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_avatar_6"
                style="@style/WidgetAvatar" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_title_6"
                    style="@style/WidgetRowTitle" />
                <TextView
                    android:id="@+id/widget_source_6"
                    style="@style/WidgetRowMeta" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_avatar_7"
                style="@style/WidgetAvatar" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_title_7"
                    style="@style/WidgetRowTitle" />
                <TextView
                    android:id="@+id/widget_source_7"
                    style="@style/WidgetRowMeta" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
