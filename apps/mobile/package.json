{
  "name": "@purss/mobile",
  "private": true,
  "description": "Android and iOS apps: the web app's build in a Capacitor shell",
  "type": "module",
  "scripts": {
    "sync": "node scripts/patch-plugins.ts && node scripts/sync-android.ts full",
    "sync:foss": "node scripts/patch-plugins.ts && node scripts/sync-android.ts foss",
    "android:debug": "npm run sync && cd android && ./gradlew assembleFullDebug"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capgo/capacitor-passkey": "8.5.8",
    "@capgo/capacitor-share-target": "8.0.65",
    "@capgo/capacitor-updater": "8.54.2",
    "@mediagrid/capacitor-native-audio": "3.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
