{
  "name": "purss",
  "private": true,
  "description": "PURSS: FreshRSS-backed personal internet dashboard",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "node scripts/check-workspace.mjs && tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=4 \"scripts/*.test.mjs\" \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "test:engine": "node --test --test-concurrency=1 \"tests/engine/*.test.ts\"",
    "test:e2e": "npm run build && npm run build:extension && node tests/acceptance/run.ts && node tests/acceptance/offline.ts && node tests/acceptance/home.ts && node tests/acceptance/connect.ts && node tests/acceptance/oauth.ts && node tests/acceptance/media.ts && node tests/acceptance/eink.ts && node tests/acceptance/email.ts && node tests/acceptance/extension.ts",
    "dev": "node scripts/dev.ts",
    "build": "npm run build -w @purss/web -w @purss/site",
    "build:extension": "npm run build -w @purss/extension"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "oauth2-mock-server": "^9.3.0",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
